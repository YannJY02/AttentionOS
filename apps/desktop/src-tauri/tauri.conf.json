{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AttentionOS",
  "version": "0.1.0",
  "identifier": "com.yannjy.attentionos",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AttentionOS",
        "width": 1180,
        "height": 820,
        "minWidth": 960,
        "minHeight": 680,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Productivity",
    "copyright": "Copyright (c) 2026 YannJY. All rights reserved.",
    "longDescription": "AttentionOS is a local-first macOS workspace for ritual, overview, planning, and protected focus.",
    "shortDescription": "Local-first attention governance and focused workflow for macOS.",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "hardenedRuntime": true,
      "infoPlist": "./Info.plist"
    }
  }
}
