#!/usr/bin/env node
import { spawn, spawnSync } from "node:child_process";
import { closeSync, existsSync, mkdirSync, openSync, readFileSync, rmSync, statSync, writeFileSync } from "node:fs";
import { createHash, randomBytes } from "node:crypto";
import net from "node:net";
import path from "node:path";
import { fileURLToPath } from "node:url";

const ROOT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../../..");
const subcmd = process.argv[2] || "all";
const outIdx = process.argv.indexOf("--out");
const OUT = path.resolve(outIdx !== -1 && process.argv[outIdx + 1] ? process.argv[outIdx + 1] : `/tmp/attentionos-verify-${process.getuid()}`);
const PUB = path.join(OUT, "public");
const STATE_FILE = path.join(OUT, "instance.json");
const STEPS_FILE = path.join(OUT, "steps.json");
const META_FILE = path.join(OUT, "run-meta.json");
const LOCK_FILE = path.join(OUT, ".verify.lock");
const DESKTOP = path.join(ROOT, "apps/desktop");
const VITE = path.join(DESKTOP, "node_modules/vite/bin/vite.js");
const SHOT = "overview-proof.png";
const REQUIRED_STEPS = ["doctor", "launch", "drive", "cleanup"];

process.umask(0o077);
if (OUT === ROOT || OUT.startsWith(ROOT + path.sep)) throw new Error("Choose an output directory outside the checkout");
mkdirSync(OUT, { recursive: true, mode: 0o700 });
if (statSync(OUT).uid !== process.getuid() || (statSync(OUT).mode & 0o077)) throw new Error("Choose a private output directory (mode 0700)");
mkdirSync(PUB, { recursive: true });

class VerifyError extends Error {
  constructor(message, exitCode = 1) {
    super(message);
    this.exitCode = exitCode;
  }
}

function runCmd(cmd, args, envExtra = {}) {
  const res = spawnSync(cmd, args, {
    cwd: ROOT,
    env: { ...process.env, ...envExtra },
    encoding: "utf8",
    maxBuffer: 32 * 1024 * 1024,
  });
  return { code: res.status ?? 1, stdout: res.stdout || "", stderr: res.stderr || "" };
}

function git(args) {
  const result = runCmd("git", args);
  if (result.code !== 0) throw new VerifyError("Cannot verify Git working tree");
  return result.stdout;
}

function checkout() {
  return { headSHA: git(["rev-parse", "HEAD"]).trim(), dirty: Boolean(git(["status", "--porcelain", "-z"])) };
}

function loadMeta() {
  if (!existsSync(META_FILE)) throw new VerifyError("Start a verification run with doctor or all", 2);
  return JSON.parse(readFileSync(META_FILE, "utf8"));
}

function startRun() {
  const meta = {
    runId: `${Date.now().toString(36)}-${randomBytes(4).toString("hex")}`,
    headSHA: checkout().headSHA,
    startedAt: new Date().toISOString(),
  };
  writeFileSync(META_FILE, JSON.stringify(meta, null, 2));
}

function acquireLock() {
  try {
    writeFileSync(LOCK_FILE, JSON.stringify({ pid: process.pid }), { flag: "wx", mode: 0o600 });
  } catch (error) {
    if (error.code !== "EEXIST") throw error;
    throw new VerifyError(`Verification output is locked at ${LOCK_FILE}. If the owner exited, use a fresh output directory.`, 2);
  }
}

function releaseLock() {
  try {
    if (existsSync(LOCK_FILE)) {
      const holder = JSON.parse(readFileSync(LOCK_FILE, "utf8"));
      if (holder.pid === process.pid) rmSync(LOCK_FILE, { force: true });
    }
  } catch {}
}

function loadSteps() {
  try {
    return existsSync(STEPS_FILE) ? JSON.parse(readFileSync(STEPS_FILE, "utf8")) : [];
  } catch {
    return [];
  }
}

function recordStep(name, status, exitCode, startedAt, detail = "") {
  const meta = loadMeta();
  const actual = checkout();
  if (status === "passed" && (actual.dirty || actual.headSHA !== meta.headSHA)) {
    throw new VerifyError(`Checkout changed or is dirty during ${name}`);
  }
  const steps = loadSteps().filter((s) => s.name !== name);
  steps.push({
    name,
    runId: meta.runId,
    headSHA: actual.headSHA,
    status,
    exitCode,
    startedAt,
    endedAt: new Date().toISOString(),
    detail,
  });
  writeFileSync(STEPS_FILE, JSON.stringify(steps, null, 2));
}

function freePort() {
  return new Promise((resolve, reject) => {
    const srv = net.createServer();
    srv.listen(0, "127.0.0.1", () => {
      const addr = srv.address();
      const port = typeof addr === "object" && addr ? addr.port : 0;
      srv.close(() => resolve(port));
    });
    srv.on("error", reject);
  });
}

function isPortOpen(port) {
  return new Promise((resolve) => {
    const sock = net.createConnection({ host: "127.0.0.1", port }, () => {
      sock.destroy();
      resolve(true);
    });
    sock.on("error", () => resolve(false));
    sock.setTimeout(400, () => {
      sock.destroy();
      resolve(false);
    });
  });
}

async function waitHttp(url, timeoutMs = 25000) {
  const deadline = Date.now() + timeoutMs;
  while (Date.now() < deadline) {
    try {
      const res = await fetch(url);
      if (res.ok) return true;
    } catch {}
    await new Promise((r) => setTimeout(r, 250));
  }
  return false;
}

function isOwnedViteProcess(pid, port) {
  if (!pid || pid <= 0) return false;
  const ps = runCmd("ps", ["-p", String(pid), "-o", "command="]);
  if (ps.code !== 0) return false;
  const cmd = ps.stdout.trim();
  return cmd.includes(VITE + " --host 127.0.0.1 --port " + port + " --strictPort");
}

async function doctor() {
  const startedAt = new Date().toISOString();
  loadMeta();
  const verifyRes = runCmd("pnpm", ["verify"]);
  writeFileSync(path.join(OUT, "doctor-verify.log"), verifyRes.stdout + "\n" + verifyRes.stderr);
  if (verifyRes.code !== 0) {
    recordStep("doctor", "failed", verifyRes.code, startedAt, "pnpm verify failed");
    throw new VerifyError(`pnpm verify failed (exit ${verifyRes.code}):\n${verifyRes.stderr || verifyRes.stdout}`, 1);
  }
  const buildRes = runCmd("pnpm", ["build"]);
  writeFileSync(path.join(OUT, "doctor-build.log"), buildRes.stdout + "\n" + buildRes.stderr);
  if (buildRes.code !== 0) {
    recordStep("doctor", "failed", buildRes.code, startedAt, "pnpm build failed");
    throw new VerifyError(`pnpm build failed (exit ${buildRes.code}):\n${buildRes.stderr || buildRes.stdout}`, 1);
  }
  recordStep("doctor", "passed", 0, startedAt, "pnpm verify + pnpm build passed");
}

async function launch() {
  const startedAt = new Date().toISOString();
  const meta = loadMeta();
  if (existsSync(STATE_FILE)) {
    await cleanup(false);
  }
  const port = await freePort();
  const baseUrl = `http://127.0.0.1:${port}`;
  const logFile = path.join(OUT, "vite.log");
  const logFd = openSync(logFile, "a");
  let child;
  try {
    child = spawn(
      process.execPath,
      [VITE, "--host", "127.0.0.1", "--port", String(port), "--strictPort"],
      {
        cwd: DESKTOP,
        detached: true,
        stdio: ["ignore", logFd, logFd],
      },
    );
  } finally {
    closeSync(logFd);
  }
  child.unref();

  writeFileSync(STATE_FILE, JSON.stringify({ runId: meta.runId, pid: child.pid, port, baseUrl, startedAt }, null, 2));
  const ready = await waitHttp(baseUrl, 25000) && isOwnedViteProcess(child.pid, port);
  if (!ready) {
    await cleanup(false);
    recordStep("launch", "failed", 2, startedAt, `Vite failed to come up on ${baseUrl}`);
    throw new VerifyError(`Vite did not respond on ${baseUrl}`, 2);
  }
  recordStep("launch", "passed", 0, startedAt, baseUrl);
}

async function drive() {
  const startedAt = new Date().toISOString();
  const meta = loadMeta();
  if (!existsSync(STATE_FILE)) throw new VerifyError("No active instance.json; run launch first", 2);
  const { baseUrl, runId, pid, port } = JSON.parse(readFileSync(STATE_FILE, "utf8"));
  if (runId !== meta.runId || baseUrl !== `http://127.0.0.1:${port}` || !isOwnedViteProcess(pid, port)) {
    throw new VerifyError("Owned test server no longer matches this run");
  }
  const pwJsonFile = path.join(OUT, "playwright-report.json");
  rmSync(pwJsonFile, { force: true });

  const pwRes = runCmd(
    "pnpm",
    ["exec", "playwright", "test", "--project=chromium", "--forbid-only", "--output", path.join(OUT, "test-results"), "--reporter=json"],
    {
      VERIFY_BASE_URL: baseUrl,
      PLAYWRIGHT_JSON_OUTPUT_NAME: pwJsonFile,
    },
  );
  writeFileSync(path.join(OUT, "playwright.log"), pwRes.stdout + "\n" + pwRes.stderr);
  if (pwRes.code !== 0) {
    recordStep("drive", "failed", pwRes.code, startedAt, "playwright suite failed");
    throw new VerifyError(`Playwright tests failed (exit ${pwRes.code}):\n${pwRes.stderr || pwRes.stdout}`, 1);
  }

  const reportRaw = existsSync(pwJsonFile) ? readFileSync(pwJsonFile, "utf8") : pwRes.stdout;
const report = JSON.parse(reportRaw);
  const passed = new Set();
  function collect(suites) {
    for (const suite of suites) {
      for (const spec of suite.specs || []) {
        const valid = spec.tests.some((test) => test.projectName === "chromium"
          && test.expectedStatus === "passed" && test.status === "expected"
          && test.results.length > 0 && test.results.every((attempt) => attempt.status === "passed"));
        if (valid) passed.add(`${spec.file}#${spec.title}`);
      }
      collect(suite.suites || []);
    }
  }
  collect(report.suites);
  const required = [
    "smoke.spec.ts#runs the Phase 1 ritual to execution workflow",
    "smoke.spec.ts#keeps the canonical stage navigation usable at 390px width",
    "evolution-learning.spec.ts#reviews a Phase 3 workflow optimization suggestion",
  ];
  const pwStats = report.stats;
  if (!pwStats || pwStats.unexpected || pwStats.skipped || pwStats.flaky || !required.every((name) => passed.has(name))) {
    throw new VerifyError("A required Chromium journey did not pass on every attempt");
  }

  const shotPath = path.join(PUB, "overview-proof.png");
  rmSync(shotPath, { force: true });
  const shotScript = `
    import { chromium } from '@playwright/test';
    const browser = await chromium.launch();
    const page = await browser.newPage({ viewport: { width: 1280, height: 820 } });
    await page.goto(${JSON.stringify(baseUrl + "/overview")}, { waitUntil: 'networkidle' });
    const heading = page.getByRole('heading', { name: 'Overview', exact: true });
    await heading.waitFor({ state: 'visible' });
    if (new URL(page.url()).pathname !== '/overview') throw new Error('Unexpected overview route');
    await page.screenshot({ path: ${JSON.stringify(shotPath)}, fullPage: true });
    await browser.close();
  `;
  const shotRes = runCmd("node", ["--input-type=module", "-e", shotScript]);
  if (shotRes.code !== 0 || !existsSync(shotPath)) {
    recordStep("drive", "failed", 1, startedAt, "screenshot capture failed");
    throw new VerifyError(`Screenshot capture failed: ${shotRes.stderr}`, 1);
  }
  writeFileSync(
    path.join(OUT, "artifact-meta.json"),
    JSON.stringify({ runId: meta.runId, headSHA: meta.headSHA, artifact: screenshotArtifact() }, null, 2),
  );
  recordStep("drive", "passed", 0, startedAt, `e2e passed (${pwStats.expected} tests, 0 skipped) + overview-proof.png`);
}

async function cleanup(record = true) {
  const startedAt = new Date().toISOString();
  if (existsSync(STATE_FILE)) {
    const state = JSON.parse(readFileSync(STATE_FILE, "utf8"));
    const { pid, port } = state;
    if (isOwnedViteProcess(pid, port)) {
      try {
        process.kill(-pid, "SIGTERM");
      } catch {
        try {
          process.kill(pid, "SIGTERM");
        } catch {}
      }
      const deadline = Date.now() + 6000;
      while (Date.now() < deadline) {
        if (!isOwnedViteProcess(pid, port) && !(await isPortOpen(port))) break;
        await new Promise((r) => setTimeout(r, 150));
      }
      if (isOwnedViteProcess(pid, port)) {
        try {
          process.kill(-pid, "SIGKILL");
        } catch {}
      }
    }
if (isOwnedViteProcess(pid, port) || await isPortOpen(port)) {
      throw new VerifyError(`Port ${port} is still in use or the owned server is still running`, 3);
    }

    rmSync(STATE_FILE, { force: true });
  }
  if (record) {
    recordStep("cleanup", "passed", 0, startedAt, "owned server verified stopped & port released");
  }
}

function screenshotArtifact() {
  const file = path.join(PUB, SHOT);
  if (!existsSync(file)) return null;
  const buf = readFileSync(file);
  if (buf.length < 24 || buf.subarray(0, 8).toString("hex") !== "89504e470d0a1a0a") return null;
  return {
    name: SHOT, path: `public/${SHOT}`, kind: "screenshot", bytes: buf.length,
    sha256: createHash("sha256").update(buf).digest("hex"), classification: "public-synthetic",
  };
}

async function evidence() {
  const startedAt = new Date().toISOString();
  const meta = loadMeta();
  const { headSHA, dirty } = checkout();
  const steps = loadSteps();
  const artMeta = existsSync(path.join(OUT, "artifact-meta.json"))
    ? JSON.parse(readFileSync(path.join(OUT, "artifact-meta.json"), "utf8")) : {};
  const shot = screenshotArtifact();
  const artifacts = shot && artMeta.runId === meta.runId && artMeta.headSHA === headSHA
    && shot.sha256 === artMeta.artifact?.sha256 && shot.bytes === artMeta.artifact?.bytes ? [shot] : [];

  const hasAllRequiredSteps = REQUIRED_STEPS.every((reqName) => {
    const s = steps.find((item) => item.name === reqName);
    return s && s.status === "passed" && s.runId === meta.runId && s.headSHA === headSHA;
  });
  const allPassed = !dirty && !existsSync(STATE_FILE) && meta.headSHA === headSHA && hasAllRequiredSteps && artifacts.length === 1;

  recordStep("evidence", allPassed ? "passed" : "failed", allPassed ? 0 : 1, startedAt, `artifacts=${artifacts.length}`);
  const manifest = {
    version: 1,
    repo: "YannJY02/AttentionOS",
    runId: meta.runId,
    headSHA,
    dirtyWorkingTree: Boolean(dirty),
    startedAt: meta.startedAt,
    endedAt: new Date().toISOString(),
    outcome: allPassed ? "passed" : "failed",
    coverage: ["docs-governance", "typecheck", "vitest", "playwright-e2e-chromium", "live-screenshot"],
    nonCoverage: ["tauri-rust-native-shell"],
    steps: loadSteps(),
    artifacts,
  };
  writeFileSync(path.join(PUB, "manifest.json"), JSON.stringify(manifest, null, 2) + "\n");
  if (!allPassed) {
    throw new VerifyError("Incomplete or mismatched verification evidence; manifest marked failed", 1);
  }
}

async function step(name) {
  rmSync(path.join(PUB, "manifest.json"), { force: true });
  const index = REQUIRED_STEPS.indexOf(name);
  if (name === "doctor") {
    await cleanup(false);
    startRun();
  }
  const meta = loadMeta();
  if (name === "evidence") return evidence();
  const prior = loadSteps().filter((entry) => REQUIRED_STEPS.slice(0, index).includes(entry.name) && entry.runId === meta.runId);
  writeFileSync(STEPS_FILE, JSON.stringify(prior, null, 2));
  if (index <= REQUIRED_STEPS.indexOf("drive")) {
    rmSync(path.join(OUT, "artifact-meta.json"), { force: true });
    rmSync(path.join(PUB, SHOT), { force: true });
  }
  const started = new Date().toISOString();
  try {
    if (name !== "cleanup") {
      const actual = checkout();
      if (actual.dirty || actual.headSHA !== meta.headSHA) throw new VerifyError("Verify requires a clean, unchanged checkout");
      if (index && !prior.some((entry) => entry.name === REQUIRED_STEPS[index - 1] && entry.status === "passed")) {
        throw new VerifyError(`Run ${REQUIRED_STEPS[index - 1]} first`);
      }
    }
    await ({ doctor, launch, drive, cleanup })[name]();
  } catch (err) {
    recordStep(name, "failed", err.exitCode || 1, started, `${name} failed; see local output`);
    throw err;
  }
}

async function main() {
  acquireLock();
  try {
    if (subcmd !== "all") {
      if (![...REQUIRED_STEPS, "evidence"].includes(subcmd)) throw new VerifyError(`Unknown subcommand: ${subcmd}`, 2);
      return await step(subcmd);
    }
    let error;
    try {
      for (const name of ["doctor", "launch", "drive"]) await step(name);
    } catch (err) {
      error = err;
    }
    for (const name of ["cleanup", "evidence"]) {
      try { await step(name); } catch (err) { error ??= err; }
    }
    if (error) throw error;
  } finally {
    releaseLock();
  }
}

main().catch((err) => {
  process.stderr.write(`[verify:attentionos] ${err?.message || err}\n`);
  process.exit(err?.exitCode || 1);
});
