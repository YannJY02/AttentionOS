{
  "name": "attentionos",
  "version": "0.0.1",
  "private": true,
  "description": "Personal Context OS — attention governance and workflow management",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "vitest --config vitest.config.ts",
    "test:run": "vitest run --config vitest.config.ts",
    "test:filter": "turbo test",
    "coverage": "vitest run --config vitest.config.ts --coverage",
    "docs:check": "node scripts/check-doc-governance.mjs",
    "boundaries:check": "node scripts/check-architecture-boundaries.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "check": "pnpm docs:check && pnpm boundaries:check && turbo check",
    "verify": "pnpm check && pnpm test:run",
    "e2e": "playwright test",
    "qa:browser:release": "node scripts/qa-browser-release-workflow.mjs",
    "release:check:macos": "node scripts/check-macos-release-readiness.mjs",
    "lint": "biome check .",
    "performance:check:macos": "node scripts/check-native-performance.mjs",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "turbo": "^2.8.20",
    "typescript": "^5.9.3",
    "vitest": "catalog:"
  }
}
