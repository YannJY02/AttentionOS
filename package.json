{
  "name": "attentionos",
  "version": "0.0.1",
  "private": true,
  "description": "Personal Context OS — attention governance and workflow management",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
